{
  "name": "codeatlas",
  "version": "0.1.0",
  "description": "Production-ready CLI tool for generating, explaining, and onboarding codebases.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codeatlas": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.5.0",
    "commander": "^12.1.0",
    "figlet": "^1.8.0",
    "inquirer": "^12.4.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}